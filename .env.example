# Copy to backend/.env (gitignored) and fill in before the live spike.

# Domino AI Gateway base URL (OpenAI-shape, ends in /v1). Dogfood instance:
GATEWAY_BASE_URL=https://apps.cloud-dogfood.domino.tech/apps/llm_gateway/v1

# Auth token (Authorization: Bearer). Two ways:
#  - IN a Domino workspace/job: leave GATEWAY_API_KEY blank; the shim fetches a fresh
#    short-lived token from the sidecar (GATEWAY_TOKEN_URL, default below).
#  - OFF Domino (laptop): the sidecar is unreachable, so set a long-lived dgw_ PAT here.
GATEWAY_API_KEY=
GATEWAY_TOKEN_URL=http://localhost:8899/access-token

# Leave GATEWAY_BASE_URL blank to run the shim against the in-process fake (no network).

# Model tier aliases (defaults shown; override per deployment). See MODELS.md.
SAGE_MODEL_SOVEREIGN=qwen-2-5
SAGE_MODEL_PLAN=gpt-5.4
SAGE_MODEL_IMPLEMENT=bedrock-qwen3-coder
SAGE_MODEL_DEFAULT=sonnet
