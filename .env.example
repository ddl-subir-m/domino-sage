# Copy to backend/.env (gitignored) and fill in.
#
# Provider mode (SAGE_GATEWAY_MODE): auto (default) | domino | openai | fake
#   auto  -> dgw_ key / no key / domino-looking URL => domino; else a key => openai
#   fake  -> no GATEWAY_BASE_URL: in-process fake, offline (no model calls)
# /healthz reports the resolved mode. openai mode exercises the MECHANISM only, NOT the real
# Domino sovereign guarantee.

# ---- Option A: Domino LLM gateway (the real thing; sovereign switch is real) ----
GATEWAY_BASE_URL=https://apps.cloud-dogfood.domino.tech/apps/llm_gateway/v1
# In a Domino workspace leave GATEWAY_API_KEY blank -> sidecar token per request.
# Off-Domino set a long-lived dgw_ PAT.
GATEWAY_API_KEY=
GATEWAY_TOKEN_URL=http://localhost:8899/access-token

# ---- Option B: generic hosted OpenAI-compatible endpoint (local Mac full E2E) ----
# Uncomment these (and comment Option A) to run the whole loop on your Mac against any
# OpenAI-compatible host. No sidecar needed; the key is a normal API key.
# GATEWAY_BASE_URL=https://YOUR-HOST/v1
# GATEWAY_API_KEY=sk-...            # supplied later
# SAGE_GATEWAY_MODE=openai          # optional; auto also picks openai for a non-dgw_ key
# In openai mode set the model aliases to models the host actually serves:
# SAGE_MODEL_SOVEREIGN=... SAGE_MODEL_PLAN=... SAGE_MODEL_IMPLEMENT=... SAGE_MODEL_DEFAULT=...

# Model tier aliases (defaults are Domino gateway aliases; see MODELS.md).
SAGE_MODEL_SOVEREIGN=qwen-2-5
SAGE_MODEL_PLAN=gpt-5.4
SAGE_MODEL_IMPLEMENT=bedrock-qwen3-coder
SAGE_MODEL_DEFAULT=sonnet

# Dataset tag name that means "sovereign-only" (Step 6). Default: sensitive
SAGE_SENSITIVITY_TAG=sensitive
