{
  "compilerOptions": {
    /* Where `tsc -b` (npm run build) parks its build-state file. Drop this and the file lands next
       to this one in the app root, untracked and visible in the Workbench Files panel. `incremental`
       stays off on purpose: the feedback runner's `tsc --noEmit -p` is the agent's error signal, and
       ~0.1s off a 0.35s check is not worth a cache that can go stale over a real error. */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Correctness only. Style/hygiene flags (noUnusedLocals/Parameters, noUncheckedIndexedAccess,
       verbatimModuleSyntax) are deliberately off: they turn ordinary agent-written code into dozens
       of build-blocking errors that don't affect the running app and burn the feedback loop's
       iteration budget. erasableSyntaxOnly stays — vite/esbuild strips types without a full TS
       transform, so non-erasable syntax (enums, namespaces) would break at runtime. */
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
