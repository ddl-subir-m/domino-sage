# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / React / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Secrets / credentials (never commit gateway keys)
*.pem
*.key
secrets/
.secrets/

# Tooling state (not project files)
.tokensave/
.gstack/
**/.gstack/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Builder runtime (generated app workspaces, previews)
workspaces/
.tmp/

# Scratch / spike scratch files (never commit)
**/_spike*.py
**/_scratch*.py

# Domino API specs. ~1-2 MB each and they move with every Domino release, so fetch
# them on demand with spikes/domino-probes/fetch_api_specs.sh rather than vendoring.
# Both are served unauthenticated from any deployment's /assets/.
spikes/domino-probes/public-api.json
spikes/domino-probes/swagger.json
spikes/domino-probes/dogfood-swagger.json
